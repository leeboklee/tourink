# Tourink local / production env
# Copy to .env and adjust. SQLite works out of the box; swap DATABASE_URL for Supabase/Postgres when ready.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prisma — local SQLite (default). For Supabase/Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tourink?sslmode=require"
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth (required in production)
AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth (leave blank to use demo credentials only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Optional Stripe (test mode). Without keys, checkout uses marked test-success path.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Public feature flags (tourist surfaces) ──────────────────────────
# Prefer Admin → Features (/admin/features) to flip public.hotels / public.experiences in DB.
# Default: Hotels / Experiences hidden from nav; direct URLs redirect to feed.
# Staging override: set to true to force public + booking UI on with mock providers.
# Live partner keys also auto-enable public exposure + booking.
NEXT_PUBLIC_ENABLE_HOTELS=false
NEXT_PUBLIC_ENABLE_EXPERIENCES=false

# Hotel inventory provider: mock (default) | expedia | amadeus
# Partner approval required for live Expedia Rapid / Amadeus / Booking.com Demand API.
# When HOTEL_PROVIDER=expedia|amadeus AND keys are present → hotels auto-enable publicly.
HOTEL_PROVIDER=mock

# Expedia Rapid (EAN) — after partner approval: https://developers.expediagroup.com/rapid/setup
# Sandbox: test.ean.com · Production: api.ean.com
EXPEDIA_API_KEY=
EXPEDIA_SHARED_SECRET=
EXPEDIA_ENV=test

# Amadeus Hotel APIs — Enterprise credentials (self-service portal decommissioned)
# Test host: test.travel.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Booking.com Demand API (Managed Affiliate only — not wired; affiliate id/token when approved)
# BOOKING_AFFILIATE_ID=
# BOOKING_API_TOKEN=

# Experience inventory provider: mock (default) | klook | viator | getyourguide
# Live APIs need partner approval. When provider + keys are set → experiences auto-enable.
EXPERIENCE_PROVIDER=mock

# Klook (demand/affiliate) — commercial BD agreement required for transactional API
# Docs note: public OpenAPI is supplier OCTO (inverted); Tourink shopping needs partner keys.
KLOOK_API_KEY=
KLOOK_AFFILIATE_ID=
KLOOK_ENV=test

# Viator Partner API — Basic Access is self-serve; Full + Booking needs approval + certification
# https://docs.viator.com · https://partnerresources.viator.com
VIATOR_API_KEY=
VIATOR_ENV=test

# GetYourGuide Partner API — X-ACCESS-TOKEN from partner onboarding
# Test: https://api.gygtest.net · Prod: https://api.getyourguide.com
GYG_ACCESS_TOKEN=
GYG_ENV=test

# Free public APIs (no keys): Open-Meteo weather on feed, Nominatim geo in Search, Unsplash images.

# Demo traveler password is set by seed: tourink-demo

# Staff Admin CMS (/admin) — seeded user admin@tourink
ADMIN_PASSWORD=tourink-admin
